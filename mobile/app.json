{
  "expo": {
    "name": "Folio",
    "slug": "folio-expense",
    "owner": "squadralennox",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "expenseapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.folio.expenses",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Folio transcribes a short transaction you dictate for your review. The speech service may process audio online.",
        "NSMicrophoneUsageDescription": "Folio uses your microphone only while you dictate a transaction."
      }
    },
    "android": {
      "package": "com.folio.expenses",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 96,
          "backgroundColor": "#f5f7f8",
          "dark": {
            "backgroundColor": "#12171b"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Folio imports receipt photos you choose into your local expense workspace.",
          "cameraPermission": "Folio photographs receipts for your expense claims."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-asset",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": false
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "5010a68a-a7af-4b99-93c9-900a0e0292ee"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/5010a68a-a7af-4b99-93c9-900a0e0292ee"
    }
  }
}
